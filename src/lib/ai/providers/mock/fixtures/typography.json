{
  "arabicDisplayFont": { "family": "IBM Plex Sans Arabic", "weights": [700], "fallback": "system-ui, sans-serif" },
  "arabicHeadingFont": { "family": "IBM Plex Sans Arabic", "weights": [600, 700], "fallback": "system-ui, sans-serif" },
  "arabicBodyFont": { "family": "IBM Plex Sans Arabic", "weights": [400, 500], "fallback": "system-ui, sans-serif" },
  "englishDisplayFont": { "family": "Manrope", "weights": [800], "fallback": "system-ui, sans-serif" },
  "englishHeadingFont": { "family": "Manrope", "weights": [600, 700], "fallback": "system-ui, sans-serif" },
  "englishBodyFont": { "family": "Manrope", "weights": [400, 500], "fallback": "system-ui, sans-serif" },
  "fallbacks": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
  "styles": [
    { "name": "DISPLAY", "fontFamily": "IBM Plex Sans Arabic", "fontWeight": 700, "fontSize": "48px", "lineHeight": "1.2", "letterSpacing": "-0.02em", "paragraphSpacing": "0" },
    { "name": "HEADING", "fontFamily": "IBM Plex Sans Arabic", "fontWeight": 600, "fontSize": "32px", "lineHeight": "1.3", "letterSpacing": "-0.01em", "paragraphSpacing": "8px" },
    { "name": "BODY", "fontFamily": "IBM Plex Sans Arabic", "fontWeight": 400, "fontSize": "16px", "lineHeight": "1.6", "letterSpacing": "0", "paragraphSpacing": "16px" },
    { "name": "CAPTION", "fontFamily": "IBM Plex Sans Arabic", "fontWeight": 400, "fontSize": "13px", "lineHeight": "1.5", "letterSpacing": "0", "paragraphSpacing": "8px" },
    { "name": "BUTTON", "fontFamily": "IBM Plex Sans Arabic", "fontWeight": 500, "fontSize": "14px", "lineHeight": "1.4", "letterSpacing": "0.01em", "paragraphSpacing": "0" }
  ],
  "previewTexts": { "arabic": "{{projectName}}", "english": "The quick brown fox jumps over the lazy dog", "arabicBody": "نحن نؤمن بأن كل علامة تجارية تستحق أن تُروى قصتها بطريقة فريدة. من خلال فهم عميق لرؤيتك، نبني هوية بصرية تنبض بالحياة." }
}
